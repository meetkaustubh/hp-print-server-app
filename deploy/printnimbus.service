[Unit]
Description=Print Nimbus pay-and-print kiosk
After=network-online.target cups.service
Wants=network-online.target cups.service

[Service]
User=printnimbus
Group=printnimbus
WorkingDirectory=/opt/printnimbus
Environment=NODE_ENV=production
Environment=PRINTNIMBUS_EDITION=pi
Environment=PORT=80
Environment=DATA_DIR=/var/lib/printnimbus
Environment=PRINT_BACKEND=cups
Environment=TRUST_PROXY=loopback
EnvironmentFile=-/etc/printnimbus.env
ExecStartPre=+/opt/printnimbus/deploy/sync-setup-code.sh
ExecStart=/usr/bin/node --disable-warning=ExperimentalWarning src/server.js
Restart=always
RestartSec=3
# Hardening
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/printnimbus
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
