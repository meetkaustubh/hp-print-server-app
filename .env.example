# Optional. Everything day-to-day is configured in the admin panel (/admin).
# Environment variables only cover runtime plumbing, and (optionally) secrets,
# which win over anything saved in the admin panel.
PORT=3000
HOST=0.0.0.0
DATA_DIR=./data
# cups (real printer) | dryrun (development, no printer needed)
PRINT_BACKEND=cups
# 'loopback' when behind cloudflared/nginx on the same machine; 0 when directly exposed
TRUST_PROXY=loopback
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
